FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /home/jovyan/work

RUN pip install --upgrade pip && pip install \
    jupyterlab==4.2.5 \
    pandas==2.2.3 \
    numpy==2.1.3 \
    scipy==1.14.1 \
    matplotlib==3.9.2 \
    japanize-matplotlib==1.1.3 \
    seaborn==0.13.2 \
    statsmodels==0.14.4 \
    geopandas==1.0.1 \
    psycopg2-binary==2.9.10 \
    SQLAlchemy==2.0.36 \
    GeoAlchemy2==0.20.0 \
    folium==0.18.0 \
    mapclassify==2.8.1 \
    python-dotenv==1.0.1 \
    requests==2.32.3 \
    openpyxl==3.1.5

RUN useradd -m -s /bin/bash jovyan
RUN chown -R jovyan:jovyan /home/jovyan
USER jovyan

EXPOSE 8888